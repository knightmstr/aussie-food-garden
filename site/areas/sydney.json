   },
   {
    "text": "North-facing gets the most winter sun. West gets harsher afternoon sun",
    "src": "NSW Environment"
   },
   {
    "text": "Living in a unit? Check body corporate rules before using a balcony",
    "src": "City of Sydney"
   },
   {
    "text": "Put pots near a door or the kitchen so you remember to water and pick",
    "src": "City of Sydney"
   }
  ]
 },
