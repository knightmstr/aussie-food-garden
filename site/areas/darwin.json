 "prep": {
  "prep": [
   {
    "text": "Choose a spot with full sun, wind shelter and no waterlogging",
    "src": "NT Government IS4"
   },
   {
    "text": "Build or fill beds at least 10 to 15 cm high so water drains",
    "src": "NT Government IS4"
   },
   {
    "text": "Add organic matter, then mulch. Top it up often because it breaks down fast in the tropics",
    "src": "NT Government, tips for new gardens"
   },
   {
    "text": "New ground: lime at least six weeks before planting, fertiliser two to three weeks before",
    "src": "NT Government IS4"
   },
   {
    "text": "From December to February, raise small seed in containers because heavy rain washes seed away",
    "src": "NT Government IS4"
   }
  ],
  "plant": [
   {
    "text": "Plant out in the late afternoon or on a cool, cloudy day",
    "src": "NT Government IS4"
   },
   {
    "text": "Mulch straight after planting to cool the soil, hold moisture and stop weeds",
    "src": "NT Government IS4"
   },
   {
    "text": "Water seedlings in with a weak fertiliser solution",
    "src": "NT Government IS4"
   },
   {
    "text": "Check weekly for weeds, pests and disease. Early treatment improves yield",
    "src": "NT Government IS4"
   },
   {
    "text": "Dig in crop residue as soon as harvest ends, and remove diseased plants",
    "src": "NT Government IS4"
   }
  ],
  "late": [
   {
    "text": "Plan a wet-season fallow: a thick layer of organic mulch, turned in for the next season",
    "src": "NT Government IS4"
   },
   {
    "text": "Dig in crop residue and remove diseased plants",
    "src": "NT Government IS4"
   },
   {
    "text": "Fertilise and mulch before heavy rain to protect soil from erosion",
    "src": "Charles Darwin University, Dec 2014"
   }
  ]
 },
